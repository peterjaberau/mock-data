{
  "id": "editorEvaluation",
  "initial": "startEvaluation",
  "states": {
    "startEvaluation": {
      "description": "The initial state where the user begins the evaluation process of the editor.",
      "on": {
        "viewDiagram": [
          {
            "target": "viewingDiagram",
            "actions": [
              {
                "type": "inline:editorEvaluation.startEvaluation#viewDiagram[-1]#transition[0]"
              }
            ]
          }
        ]
      }
    },
    "viewingDiagram": {
      "description": "The state where the user is viewing the diagram to understand the editor capabilities.",
      "on": {
        "assessFeatures": [
          {
            "target": "assessingFeatures",
            "actions": [
              {
                "type": "inline:editorEvaluation.viewingDiagram#assessFeatures[-1]#transition[0]"
              }
            ]
          }
        ],
        "exitEvaluation": [
          {
            "target": "evaluationEnded",
            "actions": [
              {
                "type": "inline:editorEvaluation.viewingDiagram#exitEvaluation[-1]#transition[0]"
              }
            ]
          }
        ]
      }
    },
    "assessingFeatures": {
      "description": "The state where the user is assessing the features of the editor to determine suitability.",
      "on": {
        "makeDecision": [
          {
            "target": "decisionMade",
            "actions": [
              {
                "type": "inline:editorEvaluation.assessingFeatures#makeDecision[-1]#transition[0]"
              }
            ]
          }
        ]
      }
    },
    "evaluationEnded": {
      "description": "The state where the evaluation process has ended without a decision being made.",
      "type": "final"
    },
    "decisionMade": {
      "description": "The state where the user has made a decision regarding the suitability of the editor.",
      "type": "final"
    }
  }
}