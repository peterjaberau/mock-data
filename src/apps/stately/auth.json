{
  "context": "{{({ spawn }) => {\n            const client = createClient(process.env.NEXT_PUBLIC_SUPABASE_API_URL, process.env.NEXT_PUBLIC_SUPABASE_ANON_API_KEY, { localStorage: storage });\n            return {\n                client,\n                notifRef: spawn(notifMachine, { id: \"notif\" }),\n                sourceRef: spawn(makeSourceMachine({\n                    auth: client.auth,\n                    sourceRegistryData: params.sourceRegistryData,\n                    router: params.router,\n                    isEmbedded: params.isEmbbeded,\n                }), { id: \"source\" }),\n                loggedInUserData: null,\n            };\n        }}}",
  "id": "authMachine",
  "invoke": {
    "input": {},
    "src": "authStateObserver"
  },
  "initial": "initializing",
  "states": {
    "initializing": {
      "always": {
        "target": "checking_if_signed_in",
        "actions": []
      }
    },
    "checking_if_signed_in": {
      "always": [
        {
          "target": "signed_in",
          "guard": "isSignedIn",
          "actions": []
        },
        {
          "target": "signed_out",
          "actions": []
        }
      ]
    },
    "signed_in": {
      "exit": {
        "type": "clearLoggedInUserIdFromSource"
      },
      "tags": "authorized",
      "initial": "fetchingUser",
      "states": {
        "fetchingUser": {
          "invoke": {
            "input": {},
            "src": "fetchUser",
            "onDone": [
              {
                "target": "idle",
                "actions": [
                  {
                    "type": "assignLoggedInUser"
                  },
                  {
                    "type": "sendLoggedInUserIdToSource"
                  },
                  {
                    "type": "inline:auth.signed_in.fetchingUser#done.invoke.auth.signed_in.fetchingUser:invocation[0][-1]#transition[2]"
                  }
                ]
              }
            ],
            "onError": [
              {
                "target": "idle",
                "actions": [
                  {
                    "type": "broadcastUserFetchError"
                  },
                  {
                    "type": "inline:auth.signed_in.fetchingUser#error.platform.auth.signed_in.fetchingUser:invocation[0][-1]#transition[1]"
                  }
                ]
              }
            ]
          }
        },
        "idle": {}
      },
      "on": {
        "EXTERNAL_SIGN_OUT": [
          {
            "target": "external_sign_out",
            "actions": []
          }
        ]
      }
    },
    "signed_out": {
      "initial": "idle",
      "states": {
        "idle": {}
      },
      "on": {
        "EXTERNAL_SIGN_IN": [
          {
            "target": "external_sign_in",
            "actions": []
          }
        ]
      }
    },
    "external_sign_out": {
      "entry": {
        "type": "navigateToLogout"
      },
      "tags": "authorized"
    },
    "external_sign_in": {
      "entry": {
        "type": "navigateToLogin"
      }
    },
    "signing_in": {
      "entry": {
        "type": "navigateToLogin"
      },
      "type": "final"
    }
  },
  "on": {
    "SIGNED_IN": [
      {
        "target": ".signed_in",
        "actions": []
      }
    ]
  }
}