{
  "id": "sourceMachine",
  "entry": {
    "type": "inline:(machine)#entry[0]"
  },
  "initial": "checking_initial_data",
  "states": {
    "checking_initial_data": {
      "always": [
        {
          "target": "with_source",
          "guard": "inline:(machine).checking_initial_data#always[-1]#guard",
          "actions": []
        },
        {
          "target": "checking_if_on_legacy_url",
          "actions": []
        }
      ]
    },
    "with_source": {
      "initial": "loading_content",
      "states": {
        "loading_content": {
          "invoke": {
            "input": {},
            "src": "loadSourceContent",
            "onError": [
              {
                "target": "source_error",
                "actions": []
              }
            ]
          },
          "on": {
            "LOADED_FROM_REGISTRY": [
              {
                "target": "source_loaded",
                "actions": [
                  {
                    "type": "inline:(machine).with_source.loading_content#LOADED_FROM_REGISTRY[-1]#transition[0]"
                  }
                ]
              }
            ],
            "LOADED_FROM_GIST": [
              {
                "target": "#sourceMachine.with_source.source_loaded.user_does_not_own_this_source",
                "actions": [
                  {
                    "type": "inline:(machine).with_source.loading_content#LOADED_FROM_GIST[-1]#transition[0]"
                  }
                ]
              }
            ]
          }
        },
        "source_loaded": {
          "entry": {
            "type": "getLocalStorageCachedSource"
          },
          "initial": "checking_if_user_owns_source",
          "states": {
            "checking_if_user_owns_source": {
              "always": [
                {
                  "target": "user_owns_this_source",
                  "guard": "inline:(machine).with_source.source_loaded.checking_if_user_owns_source#always[-1]#guard",
                  "actions": []
                },
                {
                  "target": "user_does_not_own_this_source",
                  "actions": []
                }
              ]
            },
            "user_owns_this_source": {
              "on": {
                "SAVE": [
                  {
                    "target": "#sourceMachine.updating",
                    "guard": "inline:(machine).with_source.source_loaded.user_owns_this_source#SAVE[-1]#guard",
                    "actions": []
                  },
                  {
                    "actions": [
                      {
                        "type": "inline:(machine).with_source.source_loaded.user_owns_this_source#SAVE[-1]#transition[0]"
                      }
                    ]
                  }
                ]
              }
            },
            "user_does_not_own_this_source": {
              "on": {
                "SAVE": [
                  {
                    "target": "#sourceMachine.creating",
                    "guard": "inline:(machine).with_source.source_loaded.user_does_not_own_this_source#SAVE[-1]#guard",
                    "actions": [
                      {
                        "type": "addForkOfToDesiredName"
                      }
                    ]
                  },
                  {
                    "actions": [
                      {
                        "type": "inline:(machine).with_source.source_loaded.user_does_not_own_this_source#SAVE[-1]#transition[0]"
                      }
                    ]
                  }
                ]
              }
            }
          },
          "on": {
            "CODE_UPDATED": [
              {
                "actions": [
                  {
                    "type": "inline:(machine).with_source.source_loaded#CODE_UPDATED[-1]#transition[0]"
                  },
                  {
                    "type": "inline:(machine).with_source.source_loaded#CODE_UPDATED[-1]#transition[1]"
                  }
                ]
              }
            ],
            "LOGGED_IN_USER_ID_UPDATED": [
              {
                "target": ".checking_if_user_owns_source",
                "actions": [
                  {
                    "type": "inline:(machine).with_source.source_loaded#LOGGED_IN_USER_ID_UPDATED[-1]#transition[0]"
                  }
                ]
              }
            ]
          }
        },
        "source_error": {
          "entry": [
            {
              "type": "inline:(machine).with_source.source_error#entry[0]"
            },
            {
              "type": "inline:(machine).with_source.source_error#entry[1]"
            }
          ]
        }
      },
      "on": {
        "CREATE_NEW": [
          {
            "actions": [
              {
                "type": "openNewWindowAtRoot"
              }
            ]
          }
        ],
        "FORK": [
          {
            "target": "creating",
            "guard": "inline:(machine).with_source#FORK[-1]#guard",
            "actions": [
              {
                "type": "addForkOfToDesiredName"
              }
            ]
          },
          {
            "actions": [
              {
                "type": "inline:(machine).with_source#FORK[-1]#transition[0]"
              }
            ]
          }
        ]
      }
    },
    "checking_if_on_legacy_url": {
      "description": "This state checks if you're on /id?=<id>, and redirects to you /<id>",
      "meta": {
        "description": "This state checks if you're on /id?=<id>, and redirects to you /<id>"
      },
      "initial": "checking_if_id_on_query_params",
      "states": {
        "checking_if_id_on_query_params": {
          "always": [
            {
              "target": "redirecting",
              "guard": "inline:(machine).checking_if_on_legacy_url.checking_if_id_on_query_params#always[-1]#guard",
              "actions": []
            },
            {
              "target": "check_complete",
              "actions": []
            }
          ]
        },
        "redirecting": {
          "entry": {
            "type": "redirectToNewUrlFromLegacyUrl"
          }
        },
        "check_complete": {
          "type": "final"
        }
      },
      "onDone": {
        "target": "checking_url",
        "actions": []
      }
    },
    "creating": {
      "initial": "showingNameModal",
      "states": {
        "showingNameModal": {
          "on": {
            "CHOOSE_NAME": [
              {
                "target": "pendingSave",
                "actions": [
                  {
                    "type": "inline:(machine).creating.showingNameModal#CHOOSE_NAME[-1]#transition[0]"
                  }
                ]
              }
            ],
            "CLOSE_NAME_CHOOSER_MODAL": [
              {
                "target": "#sourceMachine.with_source.source_loaded",
                "guard": "inline:(machine).creating.showingNameModal#CLOSE_NAME_CHOOSER_MODAL[-1]#guard",
                "actions": []
              },
              {
                "target": "#sourceMachine.no_source",
                "actions": []
              }
            ]
          }
        },
        "pendingSave": {
          "invoke": {
            "input": {},
            "src": "createSourceFile",
            "onDone": [
              {
                "target": "#sourceMachine.with_source.source_loaded.user_owns_this_source",
                "actions": [
                  {
                    "type": "clearLocalStorageEntryForCurrentSource"
                  },
                  {
                    "type": "assignCreateSourceFileToContext"
                  },
                  {
                    "type": "updateURLWithMachineID"
                  },
                  {
                    "type": "inline:(machine).creating.pendingSave#done.invoke.(machine).creating.pendingSave:invocation[0][-1]#transition[3]"
                  }
                ]
              }
            ],
            "onError": [
              {
                "target": "#sourceMachine.with_source.source_loaded.checking_if_user_owns_source",
                "guard": "inline:(machine).creating.pendingSave#error.platform.(machine).creating.pendingSave:invocation[0][-1]#guard",
                "actions": [
                  {
                    "type": "showSaveErrorToast"
                  }
                ]
              },
              {
                "target": "#sourceMachine.no_source",
                "actions": [
                  {
                    "type": "showSaveErrorToast"
                  }
                ]
              }
            ]
          },
          "tags": "persisting"
        }
      }
    },
    "checking_url": {
      "entry": {
        "type": "parseQueries"
      },
      "always": [
        {
          "target": "with_source",
          "guard": "inline:(machine).checking_url#always[-1]#guard",
          "actions": []
        },
        {
          "target": "no_source",
          "actions": []
        }
      ]
    },
    "no_source": {
      "initial": "checking_if_in_local_storage",
      "states": {
        "checking_if_in_local_storage": {
          "always": [
            {
              "target": "has_cached_source",
              "guard": "hasLocalStorageCachedSource",
              "actions": []
            },
            {
              "target": "no_cached_source",
              "actions": []
            }
          ]
        },
        "has_cached_source": {
          "entry": {
            "type": "getLocalStorageCachedSource"
          }
        },
        "no_cached_source": {
          "tags": [
            "canShowWelcomeMessage",
            "noCachedSource"
          ],
          "on": {
            "EXAMPLE_REQUESTED": [
              {
                "actions": [
                  {
                    "type": "assignExampleMachineToContext"
                  }
                ]
              }
            ]
          }
        }
      },
      "on": {
        "CODE_UPDATED": [
          {
            "actions": [
              {
                "type": "inline:(machine).no_source#CODE_UPDATED[-1]#transition[0]"
              },
              {
                "type": "inline:(machine).no_source#CODE_UPDATED[-1]#transition[1]"
              }
            ]
          }
        ],
        "SAVE": [
          {
            "target": "creating",
            "guard": "inline:(machine).no_source#SAVE[-1]#guard",
            "actions": []
          },
          {
            "actions": [
              {
                "type": "inline:(machine).no_source#SAVE[-1]#transition[0]"
              }
            ]
          }
        ]
      }
    },
    "updating": {
      "invoke": {
        "input": {},
        "src": "updateSourceFile",
        "onDone": [
          {
            "target": "#sourceMachine.with_source.source_loaded.user_owns_this_source",
            "actions": [
              {
                "type": "inline:(machine).updating#done.invoke.(machine).updating:invocation[0][-1]#transition[0]"
              },
              {
                "type": "inline:(machine).updating#done.invoke.(machine).updating:invocation[0][-1]#transition[1]"
              }
            ]
          }
        ],
        "onError": [
          {
            "target": "#sourceMachine.with_source.source_loaded",
            "actions": [
              {
                "type": "inline:(machine).updating#error.platform.(machine).updating:invocation[0][-1]#transition[0]"
              }
            ]
          }
        ]
      },
      "tags": "persisting"
    }
  },
  "on": {
    "LOGGED_IN_USER_ID_UPDATED": [
      {
        "actions": [
          {
            "type": "inline:(machine)#LOGGED_IN_USER_ID_UPDATED[-1]#transition[0]"
          }
        ]
      }
    ],
    "MACHINE_ID_CHANGED": [
      {
        "actions": [
          {
            "type": "inline:(machine)#MACHINE_ID_CHANGED[-1]#transition[0]"
          }
        ],
        "meta": {}
      }
    ]
  }
}