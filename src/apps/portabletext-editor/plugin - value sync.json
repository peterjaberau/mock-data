{
  "context": "{{({ input }) => ({\n        editor: input.editor,\n        getRemoteValue: input.getRemoteValue,\n        onRemoteValueChange: input.onRemoteValueChange,\n        onRemotePatches: input.onRemotePatches,\n    })}}",
  "id": "plugin - value sync",
  "entry": {
    "type": "send initial value"
  },
  "invoke": [
    {
      "input": {},
      "src": "listen to editor"
    },
    {
      "input": {},
      "src": "listen to remote"
    },
    {
      "input": {},
      "src": "listen to remote patches"
    }
  ],
  "initial": "idle",
  "states": {
    "idle": {
      "on": {
        "patch emitted": [
          {
            "target": "local write",
            "actions": []
          }
        ],
        "mutation flushed": [
          {
            "target": "pushing to remote",
            "actions": [
              {
                "type": "push to remote"
              }
            ]
          }
        ],
        "remote value changed": [
          {
            "actions": [
              {
                "type": "apply sync"
              }
            ]
          }
        ],
        "remote patches received": [
          {
            "actions": [
              {
                "type": "apply remote patches"
              }
            ]
          }
        ]
      }
    },
    "local write": {
      "on": {
        "patch emitted": [
          {
            "actions": []
          }
        ],
        "mutation flushed": [
          {
            "target": "pushing to remote",
            "actions": [
              {
                "type": "push to remote"
              }
            ]
          }
        ],
        "remote value changed": [
          {
            "target": "pending sync",
            "actions": []
          }
        ],
        "remote patches received": [
          {
            "target": "pending sync",
            "actions": [
              {
                "type": "apply remote patches"
              }
            ]
          }
        ]
      }
    },
    "pushing to remote": {
      "on": {
        "patch emitted": [
          {
            "target": "local write",
            "actions": []
          }
        ],
        "mutation flushed": [
          {
            "actions": [
              {
                "type": "push to remote"
              }
            ]
          }
        ],
        "remote value changed": [
          {
            "target": "idle",
            "actions": []
          }
        ],
        "remote patches received": [
          {
            "actions": [
              {
                "type": "apply remote patches"
              }
            ]
          }
        ]
      }
    },
    "pending sync": {
      "on": {
        "patch emitted": [
          {
            "actions": []
          }
        ],
        "mutation flushed": [
          {
            "target": "pushing to remote",
            "actions": [
              {
                "type": "push to remote"
              }
            ]
          }
        ],
        "remote value changed": [
          {
            "actions": []
          }
        ],
        "remote patches received": [
          {
            "actions": [
              {
                "type": "apply remote patches"
              }
            ]
          }
        ]
      }
    }
  }
}