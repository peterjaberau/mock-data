{
  "context": "{{({ input }) => ({\n        editor: input.editor,\n        activeStyle: undefined,\n    })}}",
  "id": "plugin - style selector",
  "invoke": [
    {
      "input": {},
      "src": "disable listener"
    },
    {
      "input": {},
      "src": "active listener"
    }
  ],
  "initial": "disabled",
  "states": {
    "disabled": {
      "on": {
        "enable": [
          {
            "target": "enabled",
            "actions": []
          }
        ]
      }
    },
    "enabled": {
      "on": {
        "disable": [
          {
            "target": "disabled",
            "actions": []
          }
        ],
        "toggle": [
          {
            "actions": [
              {
                "type": "inline:style selector.enabled#toggle[-1]#transition[0]"
              }
            ]
          }
        ]
      }
    }
  },
  "on": {
    "set active style": [
      {
        "guard": "inline:style selector#set active style[-1]#guard",
        "actions": [
          {
            "type": "inline:style selector#set active style[-1]#transition[0]"
          }
        ]
      }
    ]
  }
}