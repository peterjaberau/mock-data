{
  "context": "{{({ input }) => ({\n        editorEngine: input.editorEngine,\n    })}}",
  "id": "editor - validate selection",
  "initial": "idle",
  "states": {
    "idle": {
      "on": {
        "validate selection": [
          {
            "target": "waiting",
            "guard": "pending operations",
            "actions": []
          },
          {
            "target": "idle",
            "actions": [
              {
                "type": "inline:validate selection.idle#validate selection[-1]#transition[0]"
              }
            ]
          }
        ]
      }
    },
    "waiting": {
      "after": {
        "0": [
          {
            "guard": "pending operations",
            "actions": [],
            "reenter": true
          },
          {
            "target": "#editor - validate selection.idle",
            "actions": [
              {
                "type": "inline:validate selection.waiting#xstate.after(0)#validate selection.waiting[-1]#transition[0]"
              }
            ]
          }
        ]
      },
      "on": {
        "validate selection": [
          {
            "actions": [],
            "reenter": true
          }
        ]
      }
    }
  }
}