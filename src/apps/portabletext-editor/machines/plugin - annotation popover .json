{
  "context": "{{({ input }) => ({\n        editor: input.editor,\n        schemaTypes: input.schemaTypes,\n        annotations: [],\n        elementRef: React.createRef<Element>(),\n    })}}",
  "id": "plugin - annotation popover",
  "invoke": {
    "input": {},
    "src": "disable listener"
  },
  "initial": "disabled",
  "states": {
    "disabled": {
      "initial": "inactive",
      "states": {
        "inactive": {
          "entry": {
            "type": "reset"
          },
          "on": {
            "set active": [
              {
                "target": "active",
                "actions": [
                  {
                    "type": "inline:annotation popover.disabled.inactive#set active[-1]#transition[0]"
                  }
                ]
              }
            ],
            "enable": [
              {
                "target": "#plugin - annotation popover.enabled.inactive",
                "actions": []
              }
            ]
          }
        },
        "active": {
          "on": {
            "set inactive": [
              {
                "target": "inactive",
                "actions": []
              }
            ],
            "enable": [
              {
                "target": "#plugin - annotation popover.enabled.active",
                "actions": []
              }
            ]
          }
        }
      }
    },
    "enabled": {
      "invoke": {
        "input": {},
        "src": "active listener"
      },
      "initial": "inactive",
      "states": {
        "inactive": {
          "entry": {
            "type": "reset"
          },
          "on": {
            "set active": [
              {
                "target": "active",
                "actions": [
                  {
                    "type": "inline:annotation popover.enabled.inactive#set active[-1]#transition[0]"
                  }
                ]
              }
            ],
            "disable": [
              {
                "target": "#plugin - annotation popover.disabled.inactive",
                "actions": []
              }
            ]
          }
        },
        "active": {
          "on": {
            "set inactive": [
              {
                "target": "inactive",
                "actions": []
              }
            ],
            "disable": [
              {
                "target": "#plugin - annotation popover.disabled.active",
                "actions": []
              }
            ],
            "set active": [
              {
                "actions": [
                  {
                    "type": "inline:annotation popover.enabled.active#set active[-1]#transition[0]"
                  }
                ]
              }
            ],
            "edit": [
              {
                "actions": [
                  {
                    "type": "inline:annotation popover.enabled.active#edit[-1]#transition[0]"
                  }
                ]
              }
            ],
            "remove": [
              {
                "actions": [
                  {
                    "type": "inline:annotation popover.enabled.active#remove[-1]#transition[0]"
                  }
                ]
              }
            ],
            "close": [
              {
                "target": "inactive",
                "actions": [
                  {
                    "type": "inline:annotation popover.enabled.active#close[-1]#transition[0]"
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}