{
  "context": "{{({ input }) => ({\n        editor: input.editor,\n        definition: input.definition,\n        triggerPattern: buildTriggerPattern(input.definition),\n        partialPattern: buildPartialPattern(input.definition),\n        completePattern: buildCompletePattern(input.definition),\n        matches: [],\n        selectedIndex: 0,\n        focusSpan: undefined,\n        patternText: \"\",\n        keyword: \"\",\n        requestedKeyword: \"\",\n        error: undefined,\n        isLoading: false,\n    })}}",
  "id": "plugin - typeahead picker",
  "initial": "idle",
  "states": {
    "idle": {
      "entry": {
        "type": "reset"
      },
      "invoke": {
        "input": {},
        "src": "trigger listener"
      },
      "on": {
        "custom.typeahead trigger found": [
          {
            "target": "active",
            "actions": [
              {
                "type": "handle trigger found"
              }
            ]
          }
        ],
        "custom.typeahead keyword found": [
          {
            "target": "checking complete",
            "actions": [
              {
                "type": "handle trigger found"
              }
            ]
          }
        ]
      }
    },
    "active": {
      "invoke": [
        {
          "input": {},
          "src": "select match listener"
        },
        {
          "input": {},
          "src": "escape listener",
          "id": "escape listener"
        },
        {
          "input": {},
          "src": "selection listener"
        },
        {
          "input": {},
          "src": "submit listener",
          "id": "submit listener"
        },
        {
          "input": {},
          "src": "text insertion listener",
          "id": "text insertion listener"
        },
        {
          "input": {},
          "src": "dismiss listener",
          "id": "dismiss listener"
        }
      ],
      "initial": "evaluating",
      "states": {
        "evaluating": {
          "always": [
            {
              "target": "loading",
              "guard": "is loading",
              "actions": []
            },
            {
              "target": "showing matches",
              "guard": "has matches",
              "actions": []
            },
            {
              "target": "no matches",
              "actions": []
            }
          ]
        },
        "loading": {
          "entry": {
            "type": "inline:typeahead picker.active.loading#entry[0]"
          },
          "initial": "debouncing",
          "states": {
            "debouncing": {
              "after": {
                "DEBOUNCE": [
                  {
                    "target": "#plugin - typeahead picker.active.loading.fetching",
                    "actions": []
                  }
                ]
              },
              "always": {
                "target": "fetching",
                "guard": "no debounce",
                "actions": []
              }
            },
            "fetching": {
              "invoke": {
                "input": {},
                "src": "get matches",
                "onDone": [
                  {
                    "target": "#plugin - typeahead picker.active.evaluating",
                    "actions": [
                      {
                        "type": "inline:typeahead picker.active.loading.fetching#done.invoke.typeahead picker.active.loading.fetching:invocation[0][-1]#transition[0]"
                      }
                    ]
                  }
                ],
                "onError": [
                  {
                    "target": "#plugin - typeahead picker.active.no matches",
                    "actions": [
                      {
                        "type": "handle error"
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "showing matches": {
          "entry": [
            {
              "type": "update submit listener context"
            },
            {
              "type": "update text insertion listener context"
            }
          ],
          "invoke": {
            "input": {},
            "src": "arrow listener"
          },
          "initial": "idle",
          "states": {
            "idle": {
              "always": {
                "target": "loading",
                "guard": "is loading",
                "actions": []
              }
            },
            "loading": {
              "entry": {
                "type": "inline:typeahead picker.active.showing matches.loading#entry[0]"
              },
              "initial": "debouncing",
              "states": {
                "debouncing": {
                  "after": {
                    "DEBOUNCE": [
                      {
                        "target": "#plugin - typeahead picker.active.showing matches.loading.fetching",
                        "actions": []
                      }
                    ]
                  },
                  "always": {
                    "target": "fetching",
                    "guard": "no debounce",
                    "actions": []
                  }
                },
                "fetching": {
                  "invoke": {
                    "input": {},
                    "src": "get matches",
                    "onDone": [
                      {
                        "target": "#plugin - typeahead picker.active.showing matches.idle",
                        "actions": [
                          {
                            "type": "handle async load complete"
                          }
                        ]
                      }
                    ],
                    "onError": [
                      {
                        "target": "#plugin - typeahead picker.active.showing matches.idle",
                        "actions": [
                          {
                            "type": "handle error"
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "always": {
            "target": "no matches",
            "guard": "no matches",
            "actions": []
          },
          "on": {
            "navigate down": [
              {
                "actions": [
                  {
                    "type": "navigate"
                  },
                  {
                    "type": "update submit listener context"
                  },
                  {
                    "type": "update text insertion listener context"
                  }
                ]
              }
            ],
            "navigate up": [
              {
                "actions": [
                  {
                    "type": "navigate"
                  },
                  {
                    "type": "update submit listener context"
                  },
                  {
                    "type": "update text insertion listener context"
                  }
                ]
              }
            ],
            "navigate to": [
              {
                "actions": [
                  {
                    "type": "navigate"
                  },
                  {
                    "type": "update submit listener context"
                  },
                  {
                    "type": "update text insertion listener context"
                  }
                ]
              }
            ],
            "select": [
              {
                "target": "#plugin - typeahead picker.idle",
                "actions": [
                  {
                    "type": "select match",
                    "params": {
                      "exact": false
                    }
                  }
                ]
              }
            ]
          }
        },
        "no matches": {
          "entry": {
            "type": "inline:typeahead picker.active.no matches#entry[0]"
          },
          "initial": "idle",
          "states": {
            "idle": {
              "always": {
                "target": "loading",
                "guard": "is loading",
                "actions": []
              }
            },
            "loading": {
              "entry": {
                "type": "inline:typeahead picker.active.no matches.loading#entry[0]"
              },
              "initial": "debouncing",
              "states": {
                "debouncing": {
                  "after": {
                    "DEBOUNCE": [
                      {
                        "target": "#plugin - typeahead picker.active.no matches.loading.fetching",
                        "actions": []
                      }
                    ]
                  },
                  "always": {
                    "target": "fetching",
                    "guard": "no debounce",
                    "actions": []
                  }
                },
                "fetching": {
                  "invoke": {
                    "input": {},
                    "src": "get matches",
                    "onDone": [
                      {
                        "target": "#plugin - typeahead picker.active.no matches.idle",
                        "actions": [
                          {
                            "type": "handle async load complete"
                          }
                        ]
                      }
                    ],
                    "onError": [
                      {
                        "target": "#plugin - typeahead picker.active.no matches.idle",
                        "actions": [
                          {
                            "type": "handle error"
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "always": {
            "target": "showing matches",
            "guard": "has matches",
            "actions": []
          }
        }
      },
      "always": [
        {
          "target": "idle",
          "guard": "no focus span",
          "actions": []
        },
        {
          "target": "idle",
          "guard": "invalid pattern",
          "actions": []
        },
        {
          "target": "idle",
          "guard": "is complete keyword",
          "actions": [
            {
              "type": "select match",
              "params": {
                "exact": false
              }
            }
          ]
        }
      ],
      "on": {
        "close": [
          {
            "target": "idle",
            "actions": []
          }
        ],
        "selection changed": [
          {
            "actions": [
              {
                "type": "handle selection changed"
              },
              {
                "type": "update submit listener context"
              },
              {
                "type": "update text insertion listener context"
              },
              {
                "type": "update escape listener context"
              },
              {
                "type": "update request dismiss listener context"
              }
            ]
          }
        ]
      }
    },
    "checking complete": {
      "invoke": [
        {
          "input": {},
          "src": "select match listener"
        },
        {
          "input": {},
          "src": "get matches",
          "onDone": [
            {
              "target": "idle",
              "guard": "inline:typeahead picker.checking complete#done.invoke.typeahead picker.checking complete:invocation[1][-1]#guard",
              "actions": [
                {
                  "type": "inline:typeahead picker.checking complete#done.invoke.typeahead picker.checking complete:invocation[1][-1]#transition[0]"
                },
                {
                  "type": "select match",
                  "params": {
                    "exact": true
                  }
                }
              ]
            },
            {
              "target": "active",
              "actions": [
                {
                  "type": "inline:typeahead picker.checking complete#done.invoke.typeahead picker.checking complete:invocation[1][-1]#transition[0]"
                }
              ]
            }
          ],
          "onError": [
            {
              "target": "#plugin - typeahead picker.active.no matches",
              "actions": [
                {
                  "type": "handle error"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}