{
  "context": "{{({ input }) => ({\n        editor: input.editor,\n        rules: input.rules,\n        endOffsets: undefined,\n        endSelection: null,\n    })}}",
  "id": "plugin - input rule",
  "invoke": {
    "input": {},
    "src": "input rule listener"
  },
  "initial": "idle",
  "states": {
    "idle": {},
    "input rule applied": {
      "invoke": [
        {
          "input": {},
          "src": "delete.backward listener"
        },
        {
          "input": {},
          "src": "operation listener"
        },
        {
          "input": {},
          "src": "selection listener"
        }
      ],
      "on": {
        "selection changed": [
          {
            "target": "idle",
            "guard": "selection changed",
            "actions": []
          }
        ],
        "history.undo raised": [
          {
            "target": "idle",
            "actions": []
          }
        ],
        "operation observed": [
          {
            "target": "idle",
            "actions": []
          }
        ]
      }
    }
  },
  "on": {
    "input rule raised": [
      {
        "target": ".input rule applied",
        "actions": [
          {
            "type": "inline:plugin - input rule#input rule raised[-1]#transition[0]"
          }
        ]
      }
    ]
  }
}