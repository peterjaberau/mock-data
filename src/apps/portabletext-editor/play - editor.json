{
  "context": "{{({ input }) => ({\n        value: input.value,\n        patchesReceived: [],\n        keyGenerator: input.keyGenerator,\n        readOnly: false,\n        featureFlags: defaultEditorFeatureFlags,\n    })}}",
  "id": "play - editor",
  "states": {
    "debug mode": {
      "initial": "hidden",
      "states": {
        "hidden": {
          "on": {
            "toggle debug mode": [
              {
                "target": "shown",
                "actions": []
              }
            ]
          }
        },
        "shown": {
          "on": {
            "toggle debug mode": [
              {
                "target": "hidden",
                "actions": []
              }
            ]
          }
        }
      }
    },
    "patches preview": {
      "initial": "hidden",
      "states": {
        "hidden": {
          "on": {
            "toggle patches preview": [
              {
                "target": "shown",
                "actions": []
              }
            ]
          }
        },
        "shown": {
          "on": {
            "toggle patches preview": [
              {
                "target": "hidden",
                "actions": []
              }
            ]
          }
        }
      }
    },
    "selection preview": {
      "initial": "hidden",
      "states": {
        "hidden": {
          "on": {
            "toggle selection preview": [
              {
                "target": "shown",
                "actions": []
              }
            ]
          }
        },
        "shown": {
          "on": {
            "toggle selection preview": [
              {
                "target": "hidden",
                "actions": []
              }
            ]
          }
        }
      }
    },
    "value preview": {
      "initial": "hidden",
      "states": {
        "hidden": {
          "on": {
            "toggle value preview": [
              {
                "target": "shown",
                "actions": []
              }
            ]
          }
        },
        "shown": {
          "on": {
            "toggle value preview": [
              {
                "target": "hidden",
                "actions": []
              }
            ]
          }
        }
      }
    },
    "patch subscription": {
      "initial": "active",
      "states": {
        "active": {
          "on": {
            "toggle patch subscription": [
              {
                "target": "paused",
                "actions": []
              }
            ]
          }
        },
        "paused": {
          "on": {
            "toggle patch subscription": [
              {
                "target": "active",
                "actions": []
              }
            ]
          }
        }
      }
    },
    "value subscription": {
      "initial": "active",
      "states": {
        "active": {
          "on": {
            "toggle value subscription": [
              {
                "target": "paused",
                "actions": []
              }
            ]
          }
        },
        "paused": {
          "on": {
            "toggle value subscription": [
              {
                "target": "active",
                "actions": []
              }
            ]
          }
        }
      }
    },
    "key generator": {
      "initial": "random",
      "states": {
        "random": {
          "on": {
            "toggle key generator": [
              {
                "target": "duplicate",
                "actions": []
              }
            ]
          }
        },
        "duplicate": {
          "on": {
            "toggle key generator": [
              {
                "target": "random",
                "actions": []
              }
            ]
          }
        }
      }
    },
    "copying patches": {
      "initial": "idle",
      "states": {
        "idle": {
          "on": {
            "copy patches": [
              {
                "target": "copying",
                "actions": []
              }
            ]
          }
        },
        "copying": {
          "invoke": {
            "input": {},
            "src": "copy text to clipboard",
            "onDone": [
              {
                "target": "idle",
                "actions": []
              }
            ],
            "onError": [
              {
                "target": "idle",
                "actions": [
                  {
                    "type": "inline:play-editor.copying patches.copying#error.platform.play-editor.copying patches.copying:invocation[0][-1]#transition[0]"
                  }
                ]
              }
            ]
          }
        }
      }
    }
  },
  "on": {
    "mutation": [
      {
        "actions": [
          {
            "type": "inline:play-editor#mutation[-1]#transition[0]"
          }
        ]
      }
    ],
    "patches": [
      {
        "actions": [
          {
            "type": "store patches received"
          },
          {
            "type": "emitPatches"
          }
        ]
      }
    ],
    "value": [
      {
        "actions": [
          {
            "type": "inline:play-editor#value[-1]#transition[0]"
          }
        ]
      }
    ],
    "remove": [
      {
        "actions": [
          {
            "type": "inline:play-editor#remove[-1]#transition[0]"
          }
        ]
      }
    ],
    "clear stored patches": [
      {
        "actions": [
          {
            "type": "remove patches from context"
          }
        ]
      }
    ],
    "add range decoration": [
      {
        "actions": [
          {
            "type": "inline:play-editor#add range decoration[-1]#transition[0]"
          }
        ]
      }
    ],
    "move range decoration": [
      {
        "actions": [
          {
            "type": "inline:play-editor#move range decoration[-1]#transition[0]"
          }
        ]
      }
    ],
    "toggle feature flag": [
      {
        "actions": [
          {
            "type": "inline:play-editor#toggle feature flag[-1]#transition[0]"
          }
        ]
      }
    ]
  },
  "type": "parallel"
}