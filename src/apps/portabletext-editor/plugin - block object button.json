{
  "context": "{{({ input }) => ({\n        editor: input.editor,\n        schemaType: input.schemaType,\n    })}}",
  "id": "plugin - block object button",
  "invoke": {
    "input": {},
    "src": "disable listener"
  },
  "initial": "disabled",
  "states": {
    "disabled": {
      "on": {
        "enable": [
          {
            "target": "enabled",
            "actions": []
          }
        ]
      }
    },
    "enabled": {
      "initial": "idle",
      "states": {
        "idle": {
          "invoke": {
            "input": {},
            "src": "keyboard shortcut listener"
          },
          "on": {
            "open dialog": [
              {
                "target": "showing dialog",
                "actions": []
              }
            ]
          }
        },
        "showing dialog": {
          "on": {
            "close dialog": [
              {
                "target": "idle",
                "actions": []
              }
            ],
            "insert": [
              {
                "target": "idle",
                "actions": [
                  {
                    "type": "insert"
                  }
                ]
              }
            ]
          }
        }
      },
      "on": {
        "disable": [
          {
            "target": "disabled",
            "actions": []
          }
        ]
      }
    }
  }
}