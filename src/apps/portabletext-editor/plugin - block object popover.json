{
  "context": "{{({ input }) => ({\n        editor: input.editor,\n        schemaTypes: input.schemaTypes,\n        blockObjects: [],\n        elementRef: React.createRef<Element>(),\n    })}}",
  "id": "plugin - block object popover",
  "invoke": [
    {
      "input": {},
      "src": "disable listener"
    },
    {
      "input": {},
      "src": "active listener"
    }
  ],
  "initial": "disabled",
  "states": {
    "disabled": {
      "initial": "inactive",
      "states": {
        "inactive": {
          "entry": {
            "type": "reset"
          },
          "on": {
            "set active": [
              {
                "target": "active",
                "actions": [
                  {
                    "type": "inline:block object popover.disabled.inactive#set active[-1]#transition[0]"
                  }
                ]
              }
            ],
            "enable": [
              {
                "target": "#plugin - block object popover.enabled.inactive",
                "actions": []
              }
            ]
          }
        },
        "active": {
          "on": {
            "set inactive": [
              {
                "target": "inactive",
                "actions": []
              }
            ],
            "enable": [
              {
                "target": "#plugin - block object popover.enabled.active",
                "actions": []
              }
            ]
          }
        }
      }
    },
    "enabled": {
      "initial": "inactive",
      "states": {
        "inactive": {
          "entry": {
            "type": "reset"
          },
          "on": {
            "set active": [
              {
                "target": "active",
                "actions": [
                  {
                    "type": "inline:block object popover.enabled.inactive#set active[-1]#transition[0]"
                  }
                ]
              }
            ],
            "disable": [
              {
                "target": "#plugin - block object popover.disabled.inactive",
                "actions": []
              }
            ]
          }
        },
        "active": {
          "on": {
            "set inactive": [
              {
                "target": "inactive",
                "actions": []
              }
            ],
            "disable": [
              {
                "target": "#plugin - block object popover.disabled.active",
                "actions": []
              }
            ],
            "set active": [
              {
                "actions": [
                  {
                    "type": "inline:block object popover.enabled.active#set active[-1]#transition[0]"
                  }
                ]
              }
            ],
            "edit": [
              {
                "actions": [
                  {
                    "type": "inline:block object popover.enabled.active#edit[-1]#transition[0]"
                  }
                ]
              }
            ],
            "remove": [
              {
                "actions": [
                  {
                    "type": "inline:block object popover.enabled.active#remove[-1]#transition[0]"
                  }
                ]
              }
            ],
            "close": [
              {
                "target": "inactive",
                "actions": [
                  {
                    "type": "inline:block object popover.enabled.active#close[-1]#transition[0]"
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}