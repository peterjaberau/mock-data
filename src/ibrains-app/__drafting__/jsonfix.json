    "Button": {
      "type": "uiBlocks",
      "name": "Button",
      "meta": {
        "title": "Button",
        "icon": "fa-regular fa-bolt",
        "desc": "Button is an extension to standard input element with icons and theming"
      },
      "schema": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "link": {
            "type": "boolean"
          },
          "icon": {
            "type": "string"
          },
          "iconPos": {
            "type": "string"
          },

          "loading": {
            "type": "boolean"
          },

          "severity": {
            "type": "string"
          },

          "disabled": {
            "type": "boolean"
          },
          "raised": {
            "type": "boolean"
          },
          "rounded": {
            "type": "boolean"
          },
          "text": {
            "type": "boolean"
          },
          "outlined": {
            "type": "boolean"
          },
          "badge": {
            "type": "string"
          }
        }
      },
      "templates": [
        {
          "title": "Basic",
          "desc": "Text to display on a button is defined with the label property",
          "variance": [
            {
              "label": "Submit",
              "size": "small"
            }
          ]
        },
        {
          "title": "Link",
          "desc": "A button can be rendered as a link as well",
          "variance": [
            {
              "label": "Link",
              "link": true,
              "size": "small"

            }
          ]
        },
        {
          "title": "Icons",
          "desc": "Icon of a button is specified with icon property and position is configured using iconPos attribute",
          "variance": [
            {
              "icon": "fa-solid fa-check",
              "size": "small"
            },
            {
              "label": "Submit",
              "icon": "fa-solid fa-check",
              "size": "small"
            },
            {
              "label": "Submit",
              "icon": "fa-solid fa-check",
              "iconPos": "right",
              "size": "small"
            }
          ]
        },
        {
          "title": "Loading",
          "desc": "Busy state is controlled with the loading property",
          "variance": [
            {
              "label": "Search",
              "icon": "fa-solid fa-check",
              "size": "small"
            },
            {
              "label": "Search",
              "icon": "fa-solid fa-check",
              "loading": true,
              "size": "small"
            }
          ]
        },
        {
          "title": "Severity",
          "desc": "Severity defines the type of button",
          "variance": [
            {
              "label": "Primary",
              "size": "small"
            },
            {
              "label": "Secondary",
              "severity": "secondary",
              "size": "small"
            },
            {
              "label": "Success",
              "severity": "success",
              "size": "small"
            },
            {
              "label": "Info",
              "severity": "info",
              "size": "small"
            },
            {
              "label": "Warning",
              "severity": "warning",
              "size": "small"
            },
            {
              "label": "Help",
              "severity": "help",
              "size": "small"
            },
            {
              "label": "Danger",
              "severity": "danger",
              "size": "small"
            }
          ]
        }
      ],
      "options": {
        "Link": {
          "icon": "fa-regular fa-bolt",
          "label": "Button Text",
          "size": "small",
          "link": false,
          "iconPos": "",
          "loading": false,
          "severity": "",
          "disabled": false,
